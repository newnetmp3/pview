{
  "manifest_version": 2,
  "name": "Pornhex Video Saver",
  "version": "1.0.0",
  "description": "Detect and download media from Pornhex video pages. Handles direct videos and standard HLS streams.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_action": {
    "default_title": "Pornhex Video Saver",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "scripts": [
      "shared.js",
      "hls.js",
      "background.js"
    ],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": [
        "*://pornhex.com/*",
        "*://*.pornhex.com/*"
      ],
      "js": [
        "shared.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "permissions": [
    "tabs",
    "webRequest",
    "downloads",
    "<all_urls>"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "pornhex-video-saver@local.addon",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
